# Dependencies
node_modules
.pnp
.pnp.js

# Build
.next
out
dist
build

# Env & secrets (never commit plaintext)
.env
.env.local
.env.*.local
.secrets-passphrase

# Python bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Encrypted secrets bundles (never commit — use GitHub Secrets / Azure Key Vault)
secrets/*.enc
secrets/*.bundle

# Azure azd local state (may contain secrets)
.azure/
tsconfig.tsbuildinfo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode
*.swp

# OS
.DS_Store
*.pptx

# Local database and generated blobs
.data/
artifacts/
test-results/
playwright-report/

# Testing / tooling
coverage
.turbo
vercel

# IDE / Cursor AI debug logs. Skills are part of the store engineering standard.
.cursor/*
!.cursor/skills/

# Graphify AST cache. The report lives in tooling/graphify.
graphify-out/

.aurafit-debug.log
