__pycache__/
*.py[cod]
*$py.class
*.pyc

# Encrypted secrets bundles (never commit — use GitHub Secrets / Azure Key Vault)
secrets/*.enc
secrets/*.bundle

# Azure azd local state (may contain secrets)
.azure/
tsconfig.tsbuildinfo

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

