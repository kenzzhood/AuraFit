generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String           @id @default(cuid())
  clerkId          String           @unique
  email            String?
  displayName      String?
  username         String?          @unique
  bio              String?
  isPublic         Boolean          @default(true)
  profileImageUrl  String?
  onboardingStatus OnboardingStatus @default(PENDING)
  measurements     Json?
  bodyAnalysis     Json?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  affiliateClicks  AffiliateClick[]
  analyticsEvents  AnalyticsEvent[]
  conversations    Conversation[]
  following        Follow[]         @relation("UserFollowing")
  followers        Follow[]         @relation("UserFollowers")
  generationJobs   GenerationJob[]
  outfits          Outfit[]
  posts            Post[]
  postComments     PostComment[]
  postLikes        PostLike[]
  stylePreference  StylePreference?
  wardrobes        Wardrobe[]
  cart             Cart?
}

model StylePreference {
  id         String   @id @default(cuid())
  userId     String   @unique
  aesthetics Json?
  colors     Json?
  brands     Json?
  occasions  Json?
  budgetMin  Int?
  budgetMax  Int?
  region     String?
  currency   String?  @default("INR")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Wardrobe {
  id        String         @id @default(cuid())
  userId    String
  name      String?
  metadata  Json?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WardrobeItem[]

  @@index([userId])
}

model WardrobeItem {
  id               String            @id @default(cuid())
  wardrobeId       String
  blobPath         String
  imageUrl         String?
  category         OutfitCategory    @default(OTHER)
  tags             Json?
  colors           Json?
  styleLabels      Json?
  brand            String?
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  fashionEmbedding FashionEmbedding?
  outfitItems      OutfitItem[]
  wardrobe         Wardrobe          @relation(fields: [wardrobeId], references: [id], onDelete: Cascade)

  @@index([wardrobeId])
  @@index([category])
}

/// Vector column managed via Prisma as Unsupported — similarity search via $queryRaw
model FashionEmbedding {
  id             String                @id @default(cuid())
  wardrobeItemId String                @unique
  modelVersion   String                @default("text-embedding-3-large")
  /// pgvector column — use raw SQL for insert/update/search
  embedding      Unsupported("vector")
  wardrobeItem   WardrobeItem          @relation(fields: [wardrobeItemId], references: [id], onDelete: Cascade)
}

model Outfit {
  id              String           @id @default(cuid())
  userId          String
  name            String?
  occasion        String?
  styleNotes      String?
  isSaved         Boolean          @default(false)
  snapshot        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  affiliateClicks AffiliateClick[]
  generatedImages GeneratedImage[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           OutfitItem[]
  posts           Post[]
  cartItems       CartItem[]

  @@index([userId])
}

model Post {
  id          String         @id @default(cuid())
  userId      String
  outfitId    String
  visibility  PostVisibility @default(PRIVATE)
  caption     String?
  lookNumber  Int?
  tags        Json?
  publishedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  outfit      Outfit         @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments    PostComment[]
  likes       PostLike[]

  @@index([userId])
  @@index([outfitId])
  @@index([visibility, publishedAt])
}

model PostLike {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  content   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model OutfitItem {
  id             String        @id @default(cuid())
  outfitId       String
  position       Int
  label          String?
  wardrobeItemId String?
  productCacheId String?
  metadata       Json?
  outfit         Outfit        @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  productCache   ProductCache? @relation(fields: [productCacheId], references: [id])
  wardrobeItem   WardrobeItem? @relation(fields: [wardrobeItemId], references: [id])

  @@index([outfitId])
}

model ProductCache {
  id          String       @id @default(cuid())
  externalId  String
  source      String
  title       String
  price       Int?
  currency    String?      @default("INR")
  imageUrl    String?
  productUrl  String
  category    String?
  raw         Json?
  expiresAt   DateTime
  createdAt   DateTime     @default(now())
  outfitItems OutfitItem[]
  cartItems   CartItem[]

  @@unique([source, externalId])
  @@index([expiresAt])
}

/// Long-lived indexed product for discovery (separate from TTL ProductCache)
model ProductIndex {
  id            String              @id @default(cuid())
  externalId    String
  source        String
  title         String
  brand         String?
  price         Int?
  currency      String              @default("INR")
  imageUrl      String?
  productUrl    String              @unique
  category      String?
  colors        Json?
  aestheticTags Json?
  rating        Float?
  availability  ProductAvailability @default(UNKNOWN)
  region        String              @default("IN")
  contentHash   String?
  raw           Json?
  lastCrawledAt DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  embedding     ProductEmbedding?

  @@unique([source, externalId])
  @@index([region, category])
  @@index([contentHash])
}

model ProductEmbedding {
  id             String                @id @default(cuid())
  productIndexId String                @unique
  modelVersion   String                @default("text-embedding-3-large")
  embedding      Unsupported("vector")
  productIndex   ProductIndex          @relation(fields: [productIndexId], references: [id], onDelete: Cascade)
}

model CrawlJob {
  id          String         @id @default(cuid())
  query       String
  region      String         @default("IN")
  category    String?
  status      CrawlJobStatus @default(QUEUED)
  provider    String?
  resultCount Int            @default(0)
  error       String?
  sessionId   String?
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime       @default(now())

  @@index([status, createdAt])
  @@index([sessionId])
}

model ProductSearchSession {
  id                String                     @id @default(cuid())
  userId            String?
  generationJobId   String?
  query             String
  region            String                     @default("IN")
  category          String?
  status            ProductSearchSessionStatus @default(PARTIAL)
  productsJson      Json?
  providerMeta      Json?
  budgetMin         Int?
  budgetMax         Int?
  aestheticKeywords Json?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([generationJobId])
  @@index([userId, status])
  @@index([updatedAt])
}

model GeneratedImage {
  id        String    @id @default(cuid())
  outfitId  String
  blobPath  String?
  cdnUrl    String?
  status    JobStatus @default(PROCESSING)
  params    Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  outfit    Outfit    @relation(fields: [outfitId], references: [id], onDelete: Cascade)

  @@index([outfitId])
}

model GenerationJob {
  id        String    @id @default(cuid())
  userId    String
  status    JobStatus @default(QUEUED)
  progress  Int       @default(0)
  jobType   JobType
  payload   Json?
  result    Json?
  error     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([createdAt])
  @@index([status, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  context   Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model AffiliateClick {
  id             String    @id @default(cuid())
  userId         String
  outfitId       String?
  source         String
  targetUrl      String
  productCacheId String?
  clickedAt      DateTime  @default(now())
  convertedAt    DateTime?
  outfit         Outfit?   @relation(fields: [outfitId], references: [id])
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, clickedAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  eventType  String
  properties Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
}

model CartItem {
  id               String        @id @default(cuid())
  cartId           String
  productCacheId   String?
  outfitId         String?
  outfitLabel      String?
  title            String
  imageUrl         String?
  productUrl       String
  affiliateUrl     String?
  retailer         String?
  affiliateNetwork String?
  price            Int?
  currency         String        @default("INR")
  category         String?
  quantity         Int           @default(1)
  addedAt          DateTime      @default(now())
  cart             Cart          @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productCache     ProductCache? @relation(fields: [productCacheId], references: [id])
  outfit           Outfit?       @relation(fields: [outfitId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([cartId, outfitId])
}

enum OnboardingStatus {
  PENDING
  COMPLETED
}

enum JobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
  CANCELLED
}

enum JobType {
  ANALYSIS
  GENERATION
  PRODUCTS
  PRODUCT_CRAWL
}

enum CrawlJobStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

enum ProductSearchSessionStatus {
  PARTIAL
  READY
  FAILED
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  UNKNOWN
}

enum PostVisibility {
  PRIVATE
  PUBLIC
}

enum OutfitCategory {
  TOP
  BOTTOM
  DRESS
  OUTERWEAR
  FOOTWEAR
  ACCESSORY
  OTHER
}
