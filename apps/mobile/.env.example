# ── Aurafit Mobile — Environment Variables ────────────────────────────────────
# Copy to .env and fill in YOUR keys. Never commit .env.
# Setup guide: docs/SETUP_YOUR_KEYS.md

# Backend API URL (LAN IP in dev, HTTPS URL in production)
EXPO_PUBLIC_API_URL=

# Clerk publishable key — same app as web (https://dashboard.clerk.com → API Keys)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
