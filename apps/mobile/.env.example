# ── Aurafit Mobile — Environment Variables ────────────────────────────────────
# Copy this file to .env and fill in the values.
# .env is gitignored and NEVER committed.

# Backend API URL
# In development: your LAN IP (find with `ipconfig getifaddr en0` on Mac)
# In production: https://your-api-domain.com
EXPO_PUBLIC_API_URL=http://192.168.x.x:3000

# Clerk publishable key (from https://dashboard.clerk.com → API Keys)
# Must start with pk_test_ (dev) or pk_live_ (production)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
