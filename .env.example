# ── App / Vercel ──────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_CDN_URL=https://cdn.aurafit.app

# ── Auth (Clerk) — required; use YOUR app from https://dashboard.clerk.com ──
# Setup guide: docs/SETUP_YOUR_KEYS.md
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/generate
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── Database (Supabase Postgres) ───────────────────────────
# Supabase → Project Settings → Database → Connection string (URI, pooling optional)
# After provision: run supabase/pgvector.sql then prisma migrate / db push
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Optional: Azure PostgreSQL instead of Supabase
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# ── Redis (optional; rate limits degrade to in-memory when unset) ──
REDIS_URL=rediss://:PASSWORD@HOST:6380

# ── Media: Cloudinary (preferred) ─────────────────────────
# https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Media: Azure Blob (legacy fallback) ───────────────────
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_WARDROBES=wardrobes
AZURE_STORAGE_CONTAINER_OUTFITS=outfits
AZURE_STORAGE_CONTAINER_PROFILES=profiles
AZURE_CDN_ENDPOINT=

# ── Queue: Inngest (preferred on Vercel) ───────────────────
# https://app.inngest.com → Apps → Sync → Event / Signing keys
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Queue: Azure Service Bus (legacy fallback) ────────────
AZURE_SERVICE_BUS_CONNECTION_STRING=
AZURE_SERVICE_BUS_QUEUE_ANALYSIS=aurafit-analysis
AZURE_SERVICE_BUS_QUEUE_GENERATION=aurafit-generation
AZURE_SERVICE_BUS_QUEUE_PRODUCTS=aurafit-products

# ── Provider order (comma-separated, first configured wins with fallback) ──
AI_PROVIDERS=azure,openai,gemini
IMAGE_PROVIDERS=azure,openai,noop
TRYON_PROVIDERS=replicate,noop
PRODUCT_SEARCH_PROVIDERS=serpapi,demo
# Layered discovery (V2 self-hosted): cache → owned pgvector index → async crawl.
# No SerpAPI needed. Add `shopping` only as emergency fallback.
PRODUCT_DISCOVERY_LAYERS=cache,index,crawl
PRODUCT_SEARCH_CACHE_TTL_SECONDS=86400
PRODUCT_RANKING_ENABLED=true
PRODUCT_CRAWL_MIN_RESULTS=4
PRODUCT_INDEX_MIN_SCORE=0.50
PRODUCT_CRAWLER_URL=http://localhost:8100
CRAWLER_API_KEY=
CRAWL_PAGE_CACHE_TTL_SECONDS=604800

# ── V2 real-product pipeline tuning ───────────────────────
# Optional emergency override (paid SerpAPI / Google Shopping):
# SERPAPI_KEY=
# PRODUCT_DISCOVERY_LAYERS=cache,shopping,index,crawl
# Candidate listings kept per SerpAPI query when shopping layer is enabled.
SERPAPI_MAX_CANDIDATES=8
# Max parallel discovery calls across the bounded pool (discoverProductsBatch).
PRODUCT_DISCOVERY_CONCURRENCY=8
# Looks resolved in parallel. Auto-defaults to 4 when index or SerpAPI is active.
# PRODUCT_LOOK_CONCURRENCY=4
INGEST_API_KEY=
AFFILIATE_PROVIDERS=amazon,generic
QUEUE_PROVIDERS=inngest,service-bus,inline
CACHE_PROVIDER=memory

# Legacy single AI provider (used if AI_PROVIDERS unset)
AI_PROVIDER=azure
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_EMBED_MODEL=text-embedding-3-large
GEMINI_API_KEY=

# ── Storage provider (cloudinary | azure) ─────────────────
STORAGE_PROVIDER=cloudinary

# Generation: preview skips board until user requests HD (or set renderQuality in API)
GENERATION_PREVIEW_ONLY=true
# renderQuality on POST /api/generate: preview | medium | hd

# Mobile app CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,exp://127.0.0.1:8081

# Expo mobile (apps/mobile/.env)
# EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:3000
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Azure OpenAI ──────────────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_GPT4O=gpt-4o
AZURE_OPENAI_DEPLOYMENT_EMBED=text-embedding-3-large
# DALL-E 3 or gpt-image-1 deployment for 6-look fashion board generation
AZURE_OPENAI_DEPLOYMENT_IMAGE=dall-e-3
AZURE_OPENAI_API_VERSION=2024-10-01-preview

# ── Azure AI Vision (wardrobe tagging) ─────────────────────
AZURE_VISION_ENDPOINT=https://YOUR_REGION.api.cognitive.microsoft.com
AZURE_VISION_API_KEY=

# ── Virtual try-on ─────────────────────────────────────────
# https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=
# owner/model — input field names vary by model; default targets IDM-VTON-style APIs
REPLICATE_TRYON_MODEL=cuuupid/idm-vton-slim
# https://huggingface.co/settings/tokens (optional; HF path is stub in this build)
HUGGINGFACE_API_TOKEN=

# ── Ecommerce / Affiliate ─────────────────────────────────
AMAZON_ASSOCIATE_TAG=aurafit-21
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=aurafit-21
FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=
MYNTRA_API_KEY=
# Google Shopping via SerpAPI (real product links for look breakdown)
# https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ── Analytics ───────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Other ─────────────────────────────────────────────────
GEMINI_API_KEY=
