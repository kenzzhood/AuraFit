# AuraFit store. A fresh clone runs with none of these set.
# Mock auth, the seeded demo store, and the mock image provider are the defaults.

# mock | azure
AURAFIT_IMAGE_PROVIDER=mock
# One value. Swap to gpt-image-2.6-sunburst when Azure lists it.
AURAFIT_IMAGE_MODEL=gpt-image-2.5-sunburst

# Only when AURAFIT_IMAGE_PROVIDER=azure
AZURE_OPENAI_IMAGE_ENDPOINT=
AZURE_OPENAI_IMAGE_API_KEY=
AZURE_OPENAI_IMAGE_API_VERSION=2025-04-01-preview

# pglite (default) | postgres
AURAFIT_DB=pglite
# Required only when AURAFIT_DB=postgres
DATABASE_URL=

# local | azure
AURAFIT_BLOB=local

# mock | entra
AURAFIT_AUTH=mock
# Entra, only when AURAFIT_AUTH=entra
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# mock | meta
AURAFIT_WHATSAPP=mock
WHATSAPP_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# mediapipe | sim
AURAFIT_GESTURE=sim
AURAFIT_CAMERA_DEVICE=

NEXT_PUBLIC_APP_URL=http://localhost:3000
AURAFIT_STORE_HOURS=10:00-21:00
AURAFIT_HAND_HOLD_MS=1000
