{
  "name": "aurafit",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:mobile": "npm run start --workspace=@aurafit/mobile",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "bash -c 'set -a && [ -f .env.local ] && . ./.env.local; set +a && prisma db push'",
    "db:studio": "prisma studio",
    "db:cleanup": "npx tsx scripts/cleanup-expired.ts",
    "setup:local": "bash scripts/start-local.sh",
    "setup:crawler": "docker compose -f docker-compose.crawler.yml up --build",
    "setup:check": "bash scripts/check-setup.sh",
    "setup:wizard": "bash scripts/complete-local-setup.sh"
  },
  "dependencies": {
    "@azure/identity": "^4.6.0",
    "@azure/openai": "^2.0.0",
    "@azure/service-bus": "^7.9.5",
    "@azure/storage-blob": "^12.26.0",
    "@clerk/nextjs": "^7.3.5",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.4.0",
    "@sentry/nextjs": "^8.53.0",
    "@tanstack/react-query": "^5.67.0",
    "ai": "^4.1.46",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.0.0",
    "gsap": "^3.15.0",
    "inngest": "^4.4.0",
    "ioredis": "^5.4.1",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.0",
    "next": "15.4.10",
    "openai": "^4.86.0",
    "posthog-js": "^1.218.0",
    "prisma": "^6.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.33.5",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.4.10",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "expo": "~52.0.28",
    "react-native": "0.76.6",
    "metro-cache": "0.81.5"
  }
}

