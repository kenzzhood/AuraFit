// ─────────────────────────────────────────────────────────────────────────────
// Aurafit production infrastructure (resource-group-scoped).
// Provisions: ACR + Log Analytics + Container Apps env + 2 Container Apps
//             + Postgres Flexible Server with pgvector.
//
// Existing resources reused (NOT created here — configure via env / azd):
//   - Azure OpenAI (your cognitive services account + deployment names)
//   - Storage account (blob containers for wardrobes / outfits / profiles)
//   - Clerk auth (Clerk Cloud)
// ─────────────────────────────────────────────────────────────────────────────

targetScope = 'resourceGroup'

@minLength(1)
@maxLength(64)
@description('Name of the environment that uniquifies all resources (e.g. prod, dev, stage).')
param environmentName string

@minLength(1)
@description('Azure region for the Container Apps + ACR + Log Analytics.')
param location string

@description('Resource token used to make resource names unique within the subscription.')
param resourceToken string = toLower(uniqueString(subscription().id, environmentName, location))

// ── Postgres ────────────────────────────────────────────────────────────────
@description('Region for Azure Database for PostgreSQL Flexible Server. Some subscriptions are offer-restricted in certain regions; defaulting to eastus which is widely available and ~5ms from eastus2.')
param postgresLocation string = 'eastus'

@description('Postgres admin password (auto-generated by azd if not provided).')
@secure()
param postgresAdminPassword string

@description('Web container image name. azd deploy overrides this with the freshly built tag.')
param webImageName string = 'mcr.microsoft.com/azuredocs/containerapps-helloworld:latest'

@description('Crawler container image name. azd deploy overrides this with the freshly built tag.')
param crawlerImageName string = 'mcr.microsoft.com/azuredocs/containerapps-helloworld:latest'

// ── Existing services to wire as env vars ──────────────────────────────────
@description('Clerk publishable key (NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY).')
param clerkPublishableKey string

@description('Clerk secret key.')
@secure()
param clerkSecretKey string

@description('Azure OpenAI endpoint (text/chat/embeddings resource).')
param azureOpenAiEndpoint string

@description('Azure OpenAI API key.')
@secure()
param azureOpenAiApiKey string

@description('Azure OpenAI image-gen endpoint (gpt-image-2).')
param azureOpenAiImageEndpoint string

@description('Azure OpenAI image-gen API key.')
@secure()
param azureOpenAiImageApiKey string

@description('Existing storage account name (e.g. aurafit).')
param azureStorageAccountName string

@description('Existing storage account key.')
@secure()
param azureStorageAccountKey string

@description('Existing storage account connection string.')
@secure()
param azureStorageConnectionString string

@description('Shared crawler API key for the web -> crawler internal call.')
@secure()
param crawlerApiKey string

@description('Optional Bright Data Web Unlocker API token for the crawler.')
@secure()
param brightDataApiToken string = ''

@description('Bright Data Web Unlocker zone name for the crawler.')
@secure()
param brightDataWebUnlockerZone string = ''

@description('Optional Oxylabs Realtime username for the crawler.')
@secure()
param oxylabsUsername string = ''

@description('Optional Oxylabs Realtime password for the crawler.')
@secure()
param oxylabsPassword string = ''

@description('Optional SerpAPI key for internet-wide Google Shopping product search.')
@secure()
param serpApiKey string = ''

@description('Inngest event key (self-hosted or Inngest Cloud).')
@secure()
param inngestEventKey string

@description('Inngest signing key (self-hosted or Inngest Cloud).')
@secure()
param inngestSigningKey string

// ── Naming ──────────────────────────────────────────────────────────────────
var tags = {
  'azd-env-name': environmentName
  app: 'aurafit'
  env: environmentName
  managedBy: 'azd'
}

// Postgres token is region-aware so swapping postgresLocation gives a brand
// new name (avoids "already exists in location X" validation conflicts from
// prior failed deployments).
var postgresToken = toLower(uniqueString(subscription().id, environmentName, postgresLocation))

var registryName = take(toLower(replace('aurafit${resourceToken}acr', '-', '')), 50)
var logsName = 'aurafit-${environmentName}-logs'
var envName = 'aurafit-${environmentName}-env'
var pgName = 'aurafit-pg-${environmentName}-${postgresToken}'
var webName = 'aurafit-web'
var crawlerName = 'aurafit-crawler'

// Container Apps assign deterministic FQDNs: <appName>.<envDefaultDomain>
var webFqdn = '${webName}.${acaEnv.outputs.defaultDomain}'
var crawlerInternalFqdn = '${crawlerName}.internal.${acaEnv.outputs.defaultDomain}'
var inngestInternalFqdn = 'aurafit-inngest.internal.${acaEnv.outputs.defaultDomain}'

// ── Modules ─────────────────────────────────────────────────────────────────
module registry 'modules/registry.bicep' = {
  name: 'registry'
  params: {
    registryName: registryName
    location: location
    tags: tags
  }
}

module acaEnv 'modules/container-apps-env.bicep' = {
  name: 'acaEnv'
  params: {
    environmentName: envName
    logsWorkspaceName: logsName
    location: location
    tags: tags
  }
}

module postgres 'modules/postgres.bicep' = {
  name: 'postgres'
  params: {
    serverName: pgName
    location: postgresLocation
    tags: tags
    administratorLoginPassword: postgresAdminPassword
  }
}

// Crawler is deployed first because the web app needs its internal FQDN.
module crawler 'modules/container-app-crawler.bicep' = {
  name: 'crawler'
  params: {
    name: crawlerName
    location: location
    tags: tags
    environmentId: acaEnv.outputs.environmentId
    registryLoginServer: registry.outputs.loginServer
    registryResourceId: registry.outputs.resourceId
    imageName: crawlerImageName
    crawlerApiKey: crawlerApiKey
    brightDataApiToken: brightDataApiToken
    brightDataWebUnlockerZone: brightDataWebUnlockerZone
    oxylabsUsername: oxylabsUsername
    oxylabsPassword: oxylabsPassword
    minReplicas: 1
    cpu: '2.0'
    memory: '4Gi'
  }
}

module web 'modules/container-app-web.bicep' = {
  name: 'web'
  params: {
    name: webName
    location: location
    tags: tags
    environmentId: acaEnv.outputs.environmentId
    registryLoginServer: registry.outputs.loginServer
    registryResourceId: registry.outputs.resourceId
    imageName: webImageName
    databaseUrl: postgres.outputs.databaseUrl
    clerkPublishableKey: clerkPublishableKey
    clerkSecretKey: clerkSecretKey
    azureOpenAiEndpoint: azureOpenAiEndpoint
    azureOpenAiApiKey: azureOpenAiApiKey
    azureOpenAiImageEndpoint: azureOpenAiImageEndpoint
    azureOpenAiImageApiKey: azureOpenAiImageApiKey
    azureStorageAccountName: azureStorageAccountName
    azureStorageAccountKey: azureStorageAccountKey
    azureStorageConnectionString: azureStorageConnectionString
    productCrawlerUrl: 'https://${crawlerInternalFqdn}'
    crawlerApiKey: crawlerApiKey
    serpApiKey: serpApiKey
    inngestEventKey: inngestEventKey
    inngestSigningKey: inngestSigningKey
    inngestBaseUrl: 'https://${inngestInternalFqdn}'
    appUrl: 'https://${webFqdn}'
    corsAllowedOrigins: 'aurafit://,https://${webFqdn},https://aurafit.app,https://www.aurafit.app'
    minReplicas: 1
    cpu: '2.0'
    memory: '4Gi'
  }
}

// ── Outputs (consumed by azd / scripts) ─────────────────────────────────────
output AZURE_RESOURCE_GROUP string = resourceGroup().name
output AZURE_LOCATION string = location
output AZURE_CONTAINER_REGISTRY_ENDPOINT string = registry.outputs.loginServer
output AZURE_CONTAINER_REGISTRY_NAME string = registry.outputs.name
output AZURE_CONTAINER_APPS_ENVIRONMENT_ID string = acaEnv.outputs.environmentId
output AZURE_CONTAINER_APPS_ENVIRONMENT_DEFAULT_DOMAIN string = acaEnv.outputs.defaultDomain
output AZURE_POSTGRES_SERVER_NAME string = postgres.outputs.serverName
output AZURE_POSTGRES_FQDN string = postgres.outputs.fqdn
output AZURE_POSTGRES_DATABASE_NAME string = postgres.outputs.databaseName
output AZURE_POSTGRES_ADMIN_LOGIN string = postgres.outputs.administratorLogin
output AZURE_WEB_APP_NAME string = web.outputs.appName
output AZURE_WEB_APP_URL string = web.outputs.appUrl
output AZURE_CRAWLER_APP_NAME string = crawler.outputs.appName
output AZURE_CRAWLER_INTERNAL_URL string = crawler.outputs.internalUrl
output SERVICE_WEB_NAME string = web.outputs.appName
output SERVICE_CRAWLER_NAME string = crawler.outputs.appName
